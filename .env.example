NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SQLite (default, no separate DB service needed):
DATABASE_URI=file:./atomic-cms.db
# Postgres (optional — swap in a connection string like this instead; database
# backups aren't supported yet for Postgres, only SQLite):
# DATABASE_URI=postgres://atomic:atomic@localhost:5432/atomic-cms
PAYLOAD_SECRET=change-this-to-a-long-random-string
CRON_SECRET=change-this-too

# MCP page-builder endpoint at /api/mcp — lets an AI assistant build and edit
# pages on this site. Grants full admin control over pages, media and site
# settings, so the endpoint stays disabled while this is blank. Must be at
# least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SECRET=

# SMTP2GO email
SMTP_API_KEY=api-xxxxxxxxxxxxxxxxxx
SMTP_FROM=hello@example.com
SMTP_FROM_NAME=Atomic CMS

# Cloudflare Turnstile (optional — leave blank to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 / S3 object storage (optional — leave blank to use local filesystem)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_URL=
